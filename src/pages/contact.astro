---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PageHero from "../components/PageHero.astro";
import Reveal from "../components/Reveal.astro";
import { formUrls, mailto } from "../data/forms";
import { site } from "../data/site";
import WindField from "../components/graphics/WindField.astro";
---

<BaseLayout
  title="Contact"
  description="Contact Dr. Sanam Dabirian at TwinBuilt Studio to discuss urban energy modeling, digital twins, and decarbonization strategy."
>
  <PageHero
    title="Get in touch"
    description="Reach TwinBuilt Studio to discuss your organization's sustainability journey."
    image="/images/district-grid.svg"
    imageAlt="Abstract district grid used as a contact page placeholder"
  />

  <section class="section-pad bg-white-soft">
    <div class="mx-auto grid max-w-6xl gap-14 px-6 md:grid-cols-2 md:px-10">
      <Reveal>
        <h2 class="text-[clamp(2rem,4vw,3.2rem)] text-charcoal">{site.principal}</h2>
        <p class="editorial mt-6 text-[1.2rem] leading-relaxed text-ink/85">
          We invite a conversation about municipalities, campuses, and building portfolios working toward net-zero goals.
        </p>
        <p class="mt-8">
          <a class="text-[1.2rem] text-charcoal underline-offset-4 hover:underline" href={mailto}>
            {site.email}
          </a>
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="/book-online/" tone="light">Book online</Button>
          <Button href={mailto} tone="light">Email TwinBuilt Studio</Button>
        </div>
      </Reveal>
      <Reveal>
        <div class="overflow-hidden rounded-[0.75rem] border border-charcoal/10">
          <WindField class="h-[220px] w-full" />
        </div>
        <div class="mt-6 rounded-[0.75rem] border border-charcoal/15 p-8">
          <h2 class="text-[clamp(1.6rem,3vw,2.2rem)] text-charcoal">Consultation request form</h2>
          <p class="editorial mt-4 text-[1.2rem] text-ink/80">
            Requests are collected through Google Forms. The native page does not send email by itself.
          </p>
          <p class="mt-4 text-[0.85rem] uppercase tracking-[0.12em] text-charcoal/60">
            CONTENT TO CONFIRM: Google Form URL
          </p>
          <div class="mt-8">
            <Button href={formUrls.contact} tone="light" newTab>
              Open contact form
            </Button>
          </div>
          <p class="mt-6 text-[1rem] text-ink/75">
            Prefer email? Contact
            <a class="underline-offset-4 hover:underline" href={mailto}>{site.email}</a>
          </p>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
