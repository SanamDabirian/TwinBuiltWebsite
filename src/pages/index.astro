---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CityNetwork from "../components/graphics/CityNetwork.astro";
import GridPattern from "../components/graphics/GridPattern.astro";
import HeroSkyline from "../components/graphics/HeroSkyline.astro";
import IconMark from "../components/graphics/IconMark.astro";
import WindField from "../components/graphics/WindField.astro";
import { site } from "../data/site";

const services = [
  {
    title: "Urban Building Energy Modeling",
    body: "Our UBEM services provide detailed analyses of energy use in urban environments, helping cities and campuses identify efficiency opportunities and plan retrofit initiatives.",
    iconSrc: "/images/services/energy-battery.svg",
    iconAlt: "Urban building energy modeling icon",
  },
  {
    title: "Digital Twin Integration",
    body: "Leverage our expertise in digital twin technology to create virtual models of buildings and districts that support smarter operational decisions.",
    iconSrc: "/images/services/city.svg",
    iconAlt: "Digital twin integration icon",
    iconZoom: 1.65,
  },
  {
    title: "Decarbonization Strategies",
    body: "We specialize in developing actionable retrofit strategies that minimize carbon footprints while enhancing building performance and structural resilience.",
    iconSrc: "/images/services/co2.svg",
    iconAlt: "Decarbonization strategies icon",
    iconZoom: 1.3,
  },
  {
    title: "Data-Driven Decision Support",
    body: "Utilize our advanced data analytics to make informed decisions that accelerate progress toward net-zero targets.",
    iconSrc: "/images/services/decision.svg",
    iconAlt: "Data-driven decision support icon",
    iconZoom: 1.65,
  },
];

const steps = [
  {
    title: "Assessing Your Needs",
    body: "We begin by conducting a thorough assessment of your current energy landscape and sustainability goals.",
    icon: "assess" as const,
  },
  {
    title: "Collaborative Strategy Development",
    body: "Our team works closely with you to develop customized strategies tailored to your context.",
    icon: "strategy" as const,
  },
  {
    title: "Ongoing Support and Evaluation",
    body: "We provide continuous support and track your progress toward net-zero targets.",
    icon: "support" as const,
  },
];
---

<BaseLayout
  title={site.name}
  description={site.description}
  image="/images/og-default.svg"
>
  <section class="relative isolate min-h-[92vh] overflow-hidden bg-deep">
    <HeroSkyline class="absolute inset-0 h-full w-full object-cover" />
    <GridPattern class="pointer-events-none absolute inset-0 h-full w-full text-mint opacity-20" />
    <div class="absolute inset-0 bg-gradient-to-r from-deep/80 via-deep/55 to-deep/20"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-deep via-transparent to-transparent"></div>
    <div class="relative mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-end px-6 pb-24 pt-32 md:px-10">
      <Reveal>
        <h1 class="max-w-5xl text-[clamp(2.6rem,7vw,5.6rem)] font-semibold leading-[1.05] text-mint">
          Building the Digital Future of Sustainable Cities
        </h1>
        <p class="editorial mt-8 max-w-3xl text-[clamp(1.15rem,2.1vw,1.5rem)] text-mint/90">
          Welcome to TwinBuilt Studio, your partner in advancing sustainable urban development. We specialize in transforming complex energy data into actionable insights for municipalities and organizations pursuing net-zero goals.
        </p>
        <div class="mt-10">
          <Button href="/book-online/">Start your journey</Button>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section-pad relative overflow-hidden bg-charcoal">
    <GridPattern class="pointer-events-none absolute inset-0 h-full w-full text-mint opacity-10" />
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2 md:px-10">
      <Reveal>
        <SectionHeading eyebrow="About TwinBuilt Studio" title="ABOUT TWINBUILT STUDIO">
          <p>
            At TwinBuilt Studio, we are passionate about building a sustainable future. Our mission is to empower cities and organizations with innovative solutions in Urban Building Energy Modeling and data-driven analytics to drive decarbonization.
          </p>
          <p class="mt-4">
            We combine engineering, sustainability, and digital technologies to deliver customized strategies that meet the unique needs of every client.
          </p>
        </SectionHeading>
        <div class="mt-10">
          <Button href="/about/">Learn more</Button>
        </div>
      </Reveal>
      <Reveal>
        <div class="overflow-hidden rounded-[0.75rem] border border-mint/15">
          <CityNetwork class="h-[320px] w-full md:h-[380px]" />
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section-pad bg-deep">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <Reveal>
        <SectionHeading eyebrow="Our services" title="OUR SERVICES">
          <p>Customized Consulting Solutions</p>
          <p class="mt-4 text-[clamp(1.05rem,1.8vw,1.25rem)]">
            Explore our comprehensive services designed to support your sustainability goals.
          </p>
        </SectionHeading>
      </Reveal>
      <div class="mt-14 grid gap-6 md:grid-cols-2 md:items-stretch">
        {services.map((service) => (
          <Reveal class="h-full">
            <ServiceCard
              title={service.title}
              body={service.body}
              iconSrc={service.iconSrc}
              iconAlt={service.iconAlt}
              iconZoom={"iconZoom" in service ? service.iconZoom : 1}
            />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad bg-sage">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <Reveal>
        <SectionHeading tone="light" title="OUR PROCESS">
          <p>
            Our consulting process is designed to yield impactful results. We employ a collaborative approach at every stage.
          </p>
        </SectionHeading>
      </Reveal>
      <ol class="mt-14 grid gap-10 md:grid-cols-3">
        {steps.map((step, index) => (
          <li>
            <Reveal>
              <IconMark name={step.icon} />
              <p class="mt-5 font-ui text-[0.72rem] uppercase tracking-[0.2em] text-charcoal/70">
                0{index + 1}
              </p>
              <h3 class="mt-4 text-[clamp(1.5rem,2.2vw,1.95rem)] text-charcoal">{step.title}</h3>
              <p class="editorial mt-4 text-[1.15rem] leading-relaxed text-ink/85">{step.body}</p>
            </Reveal>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-pad overflow-hidden bg-mint">
    <div class="mx-auto grid max-w-6xl items-stretch gap-0 px-6 md:grid-cols-2 md:px-10">
      <Reveal>
        <div class="max-w-md pr-4 md:pr-10">
          <SectionHeading tone="light" eyebrow="Get in touch" title="CONTACT US">
            <p>
              We invite you to reach out with any inquiries or to discuss how we can assist your organization's sustainability journey.
            </p>
          </SectionHeading>
          <p class="editorial mt-8 text-[1.25rem] text-ink">
            {site.principal}<br />
            <a class="underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <div class="mt-10">
            <Button href="/contact/" tone="light">Contact TwinBuilt Studio</Button>
          </div>
        </div>
      </Reveal>
      <div class="mt-12 overflow-hidden rounded-[0.75rem] md:mt-0">
        <WindField class="h-[280px] w-full md:h-full md:min-h-[360px]" />
      </div>
    </div>
  </section>
</BaseLayout>
