---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Reveal from "../components/Reveal.astro";
import CityNetwork from "../components/graphics/CityNetwork.astro";
import IconMark from "../components/graphics/IconMark.astro";
import { site } from "../data/site";

const clients = [
  "Municipalities",
  "Building owners",
  "Campuses and universities",
  "Public organizations",
  "Private organizations pursuing net-zero goals",
];
---

<BaseLayout
  title="About"
  description="TwinBuilt Studio advances urban sustainability through urban building energy modeling and building decarbonization consulting led by Dr. Sanam Dabirian."
>
  <PageHero
    title="TRANSFORMING URBAN SUSTAINABILITY"
    description="Dedicated to advancing urban sustainability through innovative consulting in Urban Building Energy Modeling (UBEM) and building decarbonization."
    image="/images/interior-light.svg"
    imageAlt="Architectural interior light used as a placeholder for the about page"
  />

  <section class="section-pad bg-white-soft">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2 md:px-10">
      <Reveal>
        <p class="editorial text-[clamp(1.15rem,2vw,1.45rem)] leading-relaxed text-ink/90">
          TwinBuilt Studio helps municipalities, building owners, campuses, and organizations pursue net-zero goals and foster more sustainable urban environments through data-driven approaches.
        </p>
        <p class="editorial mt-8 text-[clamp(1.1rem,1.9vw,1.35rem)] leading-relaxed text-ink/85">
          Our core mission is to empower clients with the tools and strategies necessary to make informed decisions for a sustainable future.
        </p>
      </Reveal>
      <Reveal>
        <div class="overflow-hidden rounded-[0.75rem] border border-charcoal/10">
          <CityNetwork class="h-[280px] w-full md:h-[340px]" />
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section-pad bg-charcoal text-mint">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <Reveal>
        <h2 class="text-[clamp(2rem,4vw,3.4rem)]">Who we serve</h2>
        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          {clients.map((item) => (
            <li class="flex items-center gap-4 border-b border-mint/20 py-4">
              <IconMark name="twin" />
              <span class="editorial text-[1.2rem]">{item}</span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </section>

  <section class="section-pad bg-sage">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <Reveal>
        <h2 class="text-[clamp(2rem,4vw,3.4rem)] text-charcoal">Our approach</h2>
        <p class="editorial mt-8 text-[clamp(1.2rem,2.2vw,1.65rem)] leading-snug text-ink/85">
          The practice combines engineering, artificial intelligence, digital twins, building energy analysis, and data-driven decision support. The aim is scalable solutions that facilitate smarter decision-making for cities, campuses, and buildings.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="section-pad bg-white-soft">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <Reveal>
        <h2 class="text-[clamp(2rem,4vw,3.4rem)] text-charcoal">Principal</h2>
        <p class="editorial mt-8 text-[clamp(1.2rem,2.2vw,1.65rem)] leading-snug text-ink/85">
          {site.principal} is the principal of TwinBuilt Studio. Additional biographical details, academic appointments, and selected publications will be added when confirmed.
        </p>
        <p class="mt-6 text-[0.85rem] uppercase tracking-[0.14em] text-charcoal/60">
          CONTENT TO CONFIRM: credentials, photo, and long-form biography
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>
