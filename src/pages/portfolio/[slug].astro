---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import PageHero from "../../components/PageHero.astro";
import Reveal from "../../components/Reveal.astro";

export async function getStaticPaths() {
  const studies = await getCollection("portfolio");
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout title={study.data.title} description={study.data.summary} image={study.data.image}>
  <PageHero title={study.data.title} description={study.data.context} image={study.data.image} imageAlt={study.data.imageAlt} />

  <article class="section-pad bg-white-soft">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <Reveal>
        <p class="text-[0.78rem] uppercase tracking-[0.16em] text-charcoal/60">
          Representative case study · not presented as named client work
        </p>
        <section class="mt-10">
          <h2 class="text-[2rem] text-charcoal">Challenge</h2>
          <p class="editorial mt-4 text-[1.3rem] leading-snug text-ink/85">{study.data.challenge}</p>
        </section>
        <section class="mt-10">
          <h2 class="text-[2rem] text-charcoal">Approach</h2>
          <p class="editorial mt-4 text-[1.3rem] leading-snug text-ink/85">{study.data.approach}</p>
        </section>
        <section class="mt-10">
          <h2 class="text-[2rem] text-charcoal">Expected value</h2>
          <p class="editorial mt-4 text-[1.3rem] leading-snug text-ink/85">{study.data.value}</p>
        </section>
        <section class="mt-10">
          <h2 class="text-[2rem] text-charcoal">Methods</h2>
          <ul class="mt-4 list-disc pl-5 text-[1.1rem] text-ink/85">
            {study.data.methods.map((method) => <li class="mt-2">{method}</li>)}
          </ul>
        </section>
        <div class="prose-body mt-10 text-[1.1rem] leading-relaxed text-ink/80">
          <Content />
        </div>
        <div class="mt-12">
          <Button href="/contact/" tone="light">Contact TwinBuilt Studio</Button>
        </div>
      </Reveal>
    </div>
  </article>
</BaseLayout>
