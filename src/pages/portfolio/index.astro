---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";
import Reveal from "../../components/Reveal.astro";

const studies = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Portfolio"
  description="Representative case studies and selected capabilities from TwinBuilt Studio in UBEM, digital twins, retrofit analysis, and municipal energy planning."
>
  <PageHero
    title="Selected capabilities"
    description="These pages describe representative case studies, project concepts, and selected capabilities. They are not presented as a list of completed confidential client engagements."
    image="/images/digital-twin.svg"
    imageAlt="Layered building forms suggesting digital twin work"
  />

  <section class="section-pad bg-white-soft">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="mb-10 text-[0.8rem] uppercase tracking-[0.14em] text-charcoal/60">
        CONTENT TO CONFIRM: which studies may be named as completed work
      </p>
      <div class="grid gap-8 md:grid-cols-2">
        {studies.map((study) => (
          <Reveal>
            <PortfolioCard
              title={study.data.title}
              summary={study.data.summary}
              href={`/portfolio/${study.id}/`}
              image={study.data.image}
              imageAlt={study.data.imageAlt}
              statusLabel="Representative capability"
            />
          </Reveal>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
