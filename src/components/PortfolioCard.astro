---
interface Props {
  title: string;
  summary: string;
  href: string;
  image: string;
  imageAlt: string;
  statusLabel?: string;
}

const { title, summary, href, image, imageAlt, statusLabel } = Astro.props;
---

<a
  href={href}
  class="group block overflow-hidden rounded-[0.75rem] border border-charcoal/10 bg-white-soft transition-colors duration-300 hover:border-charcoal/30 focus-visible:border-charcoal"
>
  <div class="aspect-[4/3] overflow-hidden bg-charcoal">
    <img
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      width="800"
      height="600"
    />
  </div>
  <div class="p-6">
    {statusLabel && (
      <p class="mb-3 text-[0.68rem] uppercase tracking-[0.18em] text-charcoal/60">{statusLabel}</p>
    )}
    <h3 class="text-[clamp(1.5rem,2.4vw,2rem)] text-charcoal">{title}</h3>
    <p class="editorial mt-3 text-[1.15rem] leading-snug text-ink/80">{summary}</p>
  </div>
</a>
