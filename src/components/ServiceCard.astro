---
interface Props {
  title: string;
  body: string;
  iconSrc: string;
  iconAlt: string;
  iconZoom?: number;
}

const { title, body, iconSrc, iconAlt, iconZoom = 1 } = Astro.props;
---

<article class="flex h-full flex-col rounded-[0.75rem] border border-mint/20 bg-deep/40 p-8 transition-colors duration-300 hover:border-brass/50 hover:bg-deep/20 focus-within:border-brass/50">
  <div class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white sm:h-28 sm:w-28">
    <img
      src={iconSrc}
      alt={iconAlt}
      class="h-[72%] w-[72%] object-contain"
      style={`transform: scale(${iconZoom});`}
      width="96"
      height="96"
    />
  </div>
  <h3 class="mt-6 text-[clamp(1.45rem,2.2vw,1.9rem)] text-mint">{title}</h3>
  <p class="editorial mt-4 flex-1 text-[1.15rem] leading-relaxed text-mint/80">{body}</p>
</article>
