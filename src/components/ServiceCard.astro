---
import IconMark from "./graphics/IconMark.astro";

interface Props {
  title: string;
  body: string;
  icon: "model" | "twin" | "carbon" | "data";
}

const { title, body, icon } = Astro.props;
---

<article class="rounded-[0.75rem] border border-mint/20 bg-deep/40 p-8 transition-colors duration-300 hover:border-brass/50 hover:bg-deep/20 focus-within:border-brass/50">
  <IconMark name={icon} />
  <h3 class="mt-6 text-[clamp(1.45rem,2.2vw,1.9rem)] text-mint">{title}</h3>
  <p class="editorial mt-4 text-[1.15rem] leading-relaxed text-mint/80">{body}</p>
</article>
