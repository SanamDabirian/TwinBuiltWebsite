---
import Button from "./Button.astro";

interface Props {
  title: string;
  duration: string;
  price: string;
  description: string;
  href: string;
}

const { title, duration, price, description, href } = Astro.props;
---

<article class="flex h-full flex-col rounded-[0.75rem] border border-charcoal/15 bg-white-soft p-8">
  <h3 class="text-[clamp(1.6rem,2.4vw,2.1rem)] text-charcoal">{title}</h3>
  <p class="mt-3 font-ui text-[0.78rem] uppercase tracking-[0.16em] text-charcoal/65">
    {duration} · {price}
  </p>
  <p class="editorial mt-5 flex-1 text-[1.2rem] leading-snug text-ink/80">{description}</p>
  <div class="mt-8">
    <Button href={href} tone="light" newTab>
      Request this consultation
    </Button>
  </div>
</article>
