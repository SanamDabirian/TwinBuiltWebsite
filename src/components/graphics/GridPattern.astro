---
interface Props {
  class?: string;
}
const { class: className = "pointer-events-none absolute inset-0 h-full w-full opacity-25" } = Astro.props;
---

<svg class={className} viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="0.4">
    <path d="M0 40 H200 M0 80 H200 M0 120 H200 M0 160 H200"/>
    <path d="M40 0 V200 M80 0 V200 M120 0 V200 M160 0 V200"/>
  </g>
  <circle class="svg-node" cx="80" cy="80" r="2" fill="currentColor"/>
  <circle class="svg-node svg-node-delay" cx="160" cy="120" r="2" fill="currentColor"/>
</svg>
