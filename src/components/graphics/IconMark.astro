---
interface Props {
  name: "model" | "twin" | "carbon" | "data" | "assess" | "strategy" | "support";
}

const { name } = Astro.props;
---

<svg class="h-16 w-16 text-brass" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {name === "model" && (
    <>
      <rect x="8" y="20" width="14" height="36" stroke="currentColor" stroke-width="1.6"/>
      <rect x="26" y="10" width="14" height="46" stroke="currentColor" stroke-width="1.6"/>
      <rect x="44" y="26" width="12" height="30" stroke="currentColor" stroke-width="1.6"/>
      <path class="svg-flow" d="M15 18 L33 8 L50 24" stroke="currentColor" stroke-width="1.4"/>
    </>
  )}
  {name === "twin" && (
    <>
      <path d="M12 44 L32 18 L52 44 Z" stroke="currentColor" stroke-width="1.6"/>
      <path class="svg-flow" d="M32 18 V8" stroke="currentColor" stroke-width="1.4"/>
      <circle class="svg-node" cx="32" cy="8" r="3" fill="currentColor"/>
    </>
  )}
  {name === "carbon" && (
    <>
      <circle cx="32" cy="32" r="18" stroke="currentColor" stroke-width="1.6"/>
      <path class="svg-flow" d="M20 36 C26 24 38 24 44 36" stroke="currentColor" stroke-width="1.6"/>
      <path d="M32 14 V22" stroke="currentColor" stroke-width="1.6"/>
    </>
  )}
  {name === "data" && (
    <>
      <path class="svg-flow" d="M10 44 L22 28 L34 36 L54 16" stroke="currentColor" stroke-width="1.6"/>
      <circle class="svg-node" cx="22" cy="28" r="3" fill="currentColor"/>
      <circle class="svg-node svg-node-delay" cx="54" cy="16" r="3" fill="currentColor"/>
      <rect x="10" y="48" width="8" height="8" stroke="currentColor"/>
      <rect x="22" y="40" width="8" height="16" stroke="currentColor"/>
      <rect x="34" y="36" width="8" height="20" stroke="currentColor"/>
    </>
  )}
  {name === "assess" && (
    <>
      <circle cx="28" cy="28" r="14" stroke="currentColor" stroke-width="1.6"/>
      <path d="M38 38 L52 52" stroke="currentColor" stroke-width="1.8"/>
    </>
  )}
  {name === "strategy" && (
    <>
      <path d="M12 48 H52" stroke="currentColor" stroke-width="1.6"/>
      <path class="svg-flow" d="M16 40 L28 24 L40 32 L50 14" stroke="currentColor" stroke-width="1.6"/>
    </>
  )}
  {name === "support" && (
    <>
      <circle cx="32" cy="32" r="16" stroke="currentColor" stroke-width="1.6"/>
      <path d="M32 20 V32 L42 38" stroke="currentColor" stroke-width="1.6"/>
      <circle class="svg-node" cx="32" cy="32" r="2.5" fill="currentColor"/>
    </>
  )}
</svg>
