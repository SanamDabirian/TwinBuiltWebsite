---
import WindTurbine from "./WindTurbine.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class:list={["h-full w-full", className]} viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1a2822"/>
      <stop offset="100%" stop-color="#121916"/>
    </linearGradient>
    <linearGradient id="glow" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="#b08a5b" stop-opacity="0"/>
      <stop offset="50%" stop-color="#b08a5b" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#f3eee6" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect width="1600" height="900" fill="url(#sky)"/>
  <g class="svg-drift" opacity="0.18" fill="#f3eee6">
    <circle cx="220" cy="120" r="70"/>
    <circle cx="1280" cy="90" r="50"/>
    <circle cx="1460" cy="180" r="90"/>
  </g>
  <path d="M0 640 C280 600 420 680 640 650 C860 620 980 700 1600 640 L1600 900 L0 900 Z" fill="#1c2621"/>
  <g fill="#2a3a32">
    <rect x="80" y="360" width="130" height="380"/>
    <rect x="230" y="280" width="110" height="460"/>
    <rect x="360" y="400" width="160" height="340"/>
    <rect x="540" y="240" width="90" height="500"/>
    <rect x="650" y="330" width="180" height="410"/>
    <rect x="860" y="200" width="120" height="540"/>
    <rect x="1000" y="310" width="150" height="430"/>
    <rect x="1170" y="260" width="100" height="480"/>
    <rect x="1290" y="380" width="180" height="360"/>
    <rect x="1490" y="300" width="80" height="440"/>
  </g>
  <g class="svg-windows" fill="#f3eee6">
    <rect x="100" y="400" width="14" height="18"/><rect x="124" y="400" width="14" height="18"/><rect x="148" y="400" width="14" height="18"/>
    <rect x="100" y="440" width="14" height="18"/><rect x="124" y="440" width="14" height="18"/><rect x="148" y="440" width="14" height="18"/>
    <rect x="250" y="320" width="16" height="22"/><rect x="276" y="320" width="16" height="22"/>
    <rect x="250" y="360" width="16" height="22"/><rect x="276" y="360" width="16" height="22"/>
    <rect x="880" y="240" width="18" height="24"/><rect x="908" y="240" width="18" height="24"/>
    <rect x="880" y="280" width="18" height="24"/><rect x="908" y="280" width="18" height="24"/>
    <rect x="1020" y="350" width="16" height="20"/><rect x="1046" y="350" width="16" height="20"/><rect x="1072" y="350" width="16" height="20"/>
    <rect x="1310" y="420" width="18" height="22"/><rect x="1340" y="420" width="18" height="22"/>
  </g>
  <path class="svg-flow" d="M90 720 C340 640 520 760 780 680 C1040 600 1240 740 1520 620" fill="none" stroke="url(#glow)" stroke-width="3"/>
  <g fill="#b08a5b">
    <circle class="svg-node" cx="90" cy="720" r="5"/>
    <circle class="svg-node svg-node-delay" cx="780" cy="680" r="5"/>
    <circle class="svg-node" cx="1520" cy="620" r="5"/>
  </g>
  <WindTurbine x={1410} y={248} mast={112} />
</svg>
