---
interface Props {
  x: number;
  y: number;
  mast?: number;
  scale?: number;
  slow?: boolean;
}

const { x, y, mast = 110, scale = 1, slow = false } = Astro.props;
const duration = slow ? "28s" : "16s";
const blade = "M -3 2 L 3 2 L 4.2 -32 L 0 -50 L -4.2 -32 Z";
---

<g transform={`translate(${x} ${y}) scale(${scale})`}>
  <rect x="-3" y="3" width="6" height={mast} rx="1" fill="#ddd4c4" />
  <g>
    <animateTransform
      attributeName="transform"
      type="rotate"
      from="0 0 0"
      to="360 0 0"
      dur={duration}
      repeatCount="indefinite"
    />
    <path d={blade} fill="#f3eee6" />
    <path d={blade} fill="#ddd4c4" transform="rotate(120 0 0)" />
    <path d={blade} fill="#b08a5b" transform="rotate(240 0 0)" />
  </g>
  <circle r="5.5" fill="#f3eee6" />
  <circle r="2" fill="#121916" />
</g>
