---
interface Props {
  class?: string;
}
const { class: className = "h-full w-full" } = Astro.props;
---

<svg class={className} viewBox="0 0 640 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="640" height="480" fill="#24312b"/>
  <g fill="none" stroke="#f3eee6" stroke-width="1.4" opacity="0.45">
    <path class="svg-flow" d="M60 360 L180 240 L300 300 L460 120 L580 180"/>
    <circle class="svg-node" cx="180" cy="240" r="7"/>
    <circle class="svg-node svg-node-delay" cx="300" cy="300" r="7"/>
    <circle class="svg-node" cx="460" cy="120" r="7"/>
  </g>
  <g fill="#ddd4c4" opacity="0.28">
    <rect x="90" y="200" width="40" height="160"/>
    <rect x="200" y="140" width="52" height="220"/>
    <rect x="340" y="180" width="70" height="180"/>
    <rect x="500" y="90" width="46" height="270"/>
  </g>
  <g class="svg-windows" fill="#f3eee6">
    <rect x="100" y="220" width="8" height="10"/><rect x="114" y="220" width="8" height="10"/>
    <rect x="212" y="160" width="10" height="12"/><rect x="228" y="160" width="10" height="12"/>
  </g>
</svg>
